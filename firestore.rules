rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Packo 기존 규칙 (건드리지 않음) ──────────────────────────
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /shared_lists/{code} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }
    match /feedback/{doc} {
      allow create: if request.auth != null;
      allow read: if request.auth.token.email == 'a912243@gmail.com';
    }

    // ── 방랑클럽 채팅방 ──────────────────────────────────────────
    match /chatRooms/{roomId} {
      // 본인 또는 관리자만 읽기
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.email == 'a912243@gmail.com'
      );
      // 로그인한 사용자면 생성 가능
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      // 본인(lastMessage 업데이트) 또는 관리자(answered 업데이트) 가능
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.email == 'a912243@gmail.com'
      );

      match /messages/{msgId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/chatRooms/$(roomId)).data.userId == request.auth.uid ||
          request.auth.token.email == 'a912243@gmail.com'
        );
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/chatRooms/$(roomId)).data.userId == request.auth.uid ||
          request.auth.token.email == 'a912243@gmail.com'
        );
      }
    }
  }
}
